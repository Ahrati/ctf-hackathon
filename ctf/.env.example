# Copy to .env and replace every password/secret/token placeholder.
# Use URL-safe random strings (for example, `openssl rand -hex 24`) for DB passwords.
PORT=3000
SESSION_DAYS=12

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_USER=ctfapp
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_DATABASE=ctf

CTFD_SECRET_KEY=replace-with-a-long-random-CTFd-secret
# App-container address. CTFd UI itself is available on the server laptop at http://127.0.0.1:8000.
CTFD_URL=http://ctfd:8000
# Generate an admin API token in CTFd settings. Keep it only in .env.
CTFD_TOKEN=

# Optional: map local team-account usernames to their CTFd personal API tokens.
# Only needed if local correct flags should also be recorded in CTFd as those teams.
CTFD_TEAM_TOKENS_JSON='{}'
# Optional map: local challenge number to the matching CTFd challenge ID.
CTFD_CHALLENGE_IDS_JSON='{}'
